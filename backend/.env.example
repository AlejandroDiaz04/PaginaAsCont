# Copiar como .env si se usa carga por entorno.
# NO subir .env ni credenciales reales.

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_base_de_datos
DB_USER=usuario_db
DB_PASS=cambiar_esta_contraseña

# Correo
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=correo@tudominio.com
MAIL_PASSWORD=cambiar_esta_contraseña
MAIL_FROM=correo@tudominio.com
MAIL_FROM_NAME=AsContSystem
MAIL_ENCRYPTION=tls
MAIL_ADMIN=admin@tudominio.com

# Sitio
SITE_URL=http://localhost
SITE_NAME=AsContSystem

# Seguridad
SESSION_LIFETIME=86400
TOKEN_EXPIRATION=172800
